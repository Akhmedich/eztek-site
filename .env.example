# Copy to .env for local work. Every value here ends up in the browser, so only public values belong here:
# never the service_role key, the database password or any secret.
# Left empty, the forms run in preview mode and send nothing (the safe default: there is one live database).

# Supabase project eztek-ops (Project Settings > General > Project ID)
PUBLIC_SUPABASE_URL=https://aechfgsnroxltupkpxbs.supabase.co
# Publishable key sb_publishable_... from Supabase > Project Settings > API Keys. Needed for /admin/ and /portal/.
PUBLIC_SUPABASE_ANON_KEY=

# Email copies of leads (Web3Forms). Leave empty locally, or use the test form's key only.
PUBLIC_FORM_ENDPOINT=
PUBLIC_FORM_KEY=

# Website assistant button: "on" to show it
PUBLIC_ASSISTANT=
